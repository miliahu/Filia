<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Filia.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      Intentionally NO Microsoft.EntityFrameworkCore reference here.
      Application talks to persistence exclusively through IFileRepository /
      IUnitOfWork (repository pattern); EF Core is an Infrastructure-only
      concern. Enforced by LayerDependencyTests.Application_ShouldNotHaveDependencyOnEntityFrameworkCore.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filia.Domain\Filia.Domain.csproj" />
  </ItemGroup>

</Project>
